# Copy to .env only if you do not already have one. Never commit credentials.
PORT=5000
PYTHON_PATH=python

# The demo always archives reports locally; PostgreSQL mirroring is optional.
OSIS_PERSIST_POSTGRES=false
# OSIS_REPORT_DIR=C:/path/to/osis-reports
# DATABASE_URL=postgresql://osis:CHANGE_ME@localhost:5432/osis

# Opt-in rollback-only database integration test (requires configured PostGIS DB).
OSIS_TEST_DATABASE=false

# Optional REAL incident adapters: local trusted assets only, no downloads/fallbacks.
# Keep PYTHON_PATH on the Python with xarray/numpy/netCDF4 for environmental sampling.
# REAL_SAR_PYTHON=C:/absolute/path/to/OSIS/.venv-ml/Scripts/python.exe
# REAL_MODEL_PATH=C:/absolute/path/to/trusted/best_sar_model.pth
# REAL_CURRENT_NETCDF=C:/absolute/path/to/cmems-surface-subset.nc
# REAL_WIND_NETCDF=C:/absolute/path/to/era5-subset.nc
# REAL_AIS_CSV=C:/absolute/path/to/observed-ais.csv
# REAL_AIS_MANIFEST=C:/absolute/path/to/observed-ais-coverage.json
# See docs/REAL_ADAPTERS.md for schema, limits, validation commands and data blockers.

# ---------------------------------------------------------------------------
# DAY 1 — Autonomous Sentinel-1 scene ingestion via CDSE
# ---------------------------------------------------------------------------
# Copernicus Data Space Ecosystem OAuth2 client credentials (required for CDSE polling).
# Create a service account at: https://identity.dataspace.copernicus.eu
# CDSE_CLIENT_ID=your-cdse-client-id
# CDSE_CLIENT_SECRET=your-cdse-client-secret

# Area of Interest: [minLon,minLat,maxLon,maxLat]
# IMPORTANT: each side must be <=0.2 degrees (sentinel.service.js hard limit ~22 km).
# Default is a 0.19°x0.19° box in the Bay of Bengal.
# POLLER_AOI_BBOX=80.0,9.0,80.19,9.19

# How often to poll CDSE in milliseconds (minimum 60000 = 1 minute; default 900000 = 15 min)
# POLLER_INTERVAL_MS=900000

# How many hours back to look on the very first poll (default 24; max 72)
# POLLER_INITIAL_LOOKBACK_HOURS=24

# Set to true to automatically start the scene poller when the Express server boots
# POLLER_AUTOSTART=false

# ---------------------------------------------------------------------------
# DAY 2 — Live AIS Ingestion via AISStream
# ---------------------------------------------------------------------------
# Get an API key from https://aisstream.io/
# AISSTREAM_API_KEY=your-aisstream-api-key

# Set to true to automatically start the live AIS ingestion service
# AIS_AUTOSTART=false